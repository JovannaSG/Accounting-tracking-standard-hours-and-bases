# Скопируйте в .env и заполните под своё окружение.
# В docker-compose.yml те же параметры задаются в блоке environment.
# Полный список переменных — в README.md, раздел «Переменные окружения».

# --- Приложение ---
UI_HOST=127.0.0.1
UI_PORT=8503

# Автовыход при бездействии, минут (0 — не выходить)
UI_IDLE_TIMEOUT_MIN=30

# --- Аутентификация ---
# Путь к JSON с пользователями вида
# {"admin": {"role": "admin", "password": "<pbkdf2-хэш>"}}
# Пустое значение или отсутствие файла — вход без пароля (только для отладки).
AUDIT_USERS=users.json

# --- База приложения ---
AUDIT_DB_PATH=norm_hours.db

# --- Шифрование паролей клиентских баз (Fernet) ---
# Ключ 32 байта в URL-safe base64. Сгенерировать:
#   python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Если ключ не задан, пароли баз хранятся без шифрования (как раньше).
# Если ключ ЗАДАН, но неверен, приложение НЕ отключает шифрование молча:
# импорт и правка баз останавливаются с ошибкой, пароль в открытом виде
# не пишется. Смена ключа делает ранее сохранённые пароли нечитаемыми —
# приложение сообщит об этом, а не подставит пустой пароль.
AUDIT_DB_SECRET_KEY=

# Лимит входа и минимальная длина пароля задаются константами в core/auth.py:
# MAX_LOGIN_ATTEMPTS (5), LOCKOUT_SECONDS (300), MIN_PASSWORD_LENGTH (8).
